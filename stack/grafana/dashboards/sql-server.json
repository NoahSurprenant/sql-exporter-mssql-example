{
  "uid": "sql-server-example",
  "title": "SQL Server example",
  "tags": [
    "sql-server"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Metrics: sql_exporter → Prometheus",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Exporter can reach SQL Server",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"sql_exporter\", target=\"mssql\"}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Batch requests / s",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(mssql_batch_requests[1m])",
          "legendFormat": "batch requests"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Connections by database",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mssql_connections",
          "legendFormat": "{{db}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top statements (plan cache)",
      "description": "mssql_query_stats: the top 20 statements per database by total elapsed time since their plans were cached.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Elapsed (s)",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mssql_query_elapsed_seconds_total",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "target": true
            },
            "renameByName": {
              "Value": "Elapsed (s)",
              "database": "Database",
              "query": "Statement",
              "query_hash": "Query hash",
              "mssql_query_elapsed_seconds_total": "Elapsed (s)",
              "mssql_procedure_elapsed_seconds_total": "Elapsed (s)",
              "mssql_missing_index_improvement": "Elapsed (s)"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Top stored procedures",
      "description": "mssql_procedure_stats: the top 20 procedures per database by total elapsed time.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Elapsed (s)",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mssql_procedure_elapsed_seconds_total",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "target": true
            },
            "renameByName": {
              "Value": "Elapsed (s)",
              "database": "Database",
              "procedure": "Procedure",
              "mssql_query_elapsed_seconds_total": "Elapsed (s)",
              "mssql_procedure_elapsed_seconds_total": "Elapsed (s)",
              "mssql_missing_index_improvement": "Elapsed (s)"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Missing-index suggestions",
      "description": "mssql_missing_indexes: the optimizer's top 10 suggestions per database by estimated improvement. Review before creating.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Improvement",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mssql_missing_index_improvement",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "target": true
            },
            "renameByName": {
              "Value": "Improvement",
              "database": "Database",
              "table": "Table",
              "equality_columns": "Equality",
              "inequality_columns": "Inequality",
              "included_columns": "Include",
              "mssql_query_elapsed_seconds_total": "Improvement",
              "mssql_procedure_elapsed_seconds_total": "Improvement",
              "mssql_missing_index_improvement": "Improvement"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Top waits (s waited / s)",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, rate(mssql_wait_seconds_total[5m]))",
          "legendFormat": "{{wait_type}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Logs: OpenTelemetry Collector sql_server receiver → Loki",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Top queries",
      "description": "db.server.top_query: the most expensive statements since the previous collection. Expand a line for executions, CPU, reads and sqlserver_query_hash.",
      "id": 10,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"sqlserver\"} | event_name=\"db.server.top_query\" | db_namespace!~\"master|msdb|model|tempdb\"",
          "maxLines": 200
        }
      ]
    },
    {
      "type": "logs",
      "title": "Execution plans",
      "description": "db.server.query_plan: the ShowPlan XML of each top query; match it by sqlserver_query_hash and sqlserver_query_plan_hash.",
      "id": 11,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"sqlserver\"} | event_name=\"db.server.query_plan\" | db_namespace!~\"master|msdb|model|tempdb\"",
          "maxLines": 50
        }
      ]
    },
    {
      "type": "logs",
      "title": "Top procedures and their definitions",
      "description": "db.server.top_procedure and db.server.procedure_definition.",
      "id": 12,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"sqlserver\"} | event_name=~\"db.server.(top_procedure|procedure_definition)\"",
          "maxLines": 200
        }
      ]
    },
    {
      "type": "logs",
      "title": "Running now (query samples)",
      "description": "db.server.query_sample: what was executing at the moment of each collection, with blocking.",
      "id": 13,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
